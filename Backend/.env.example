# FarmsAge 2.0 Backend Environment Variables
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=

# Security
JWT_SECRET=
OTP_HASH_SECRET=

# CORS Origins
FRONTEND_URL=
ADMIN_URL=
ALLOWED_ORIGINS=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
