# FarmsAge 2.0 Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/FarmsAGE

# Security
JWT_SECRET=your_jwt_secret_key_here

# CORS Origins
FRONTEND_URL=https://farms-age-2-0-7fik.vercel.app
ADMIN_URL=https://farms-age-2-0-v32x.vercel.app
ALLOWED_ORIGINS=https://farms-age-2-0-7fik.vercel.app,https://farms-age-2-0-v32x.vercel.app

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# SMS (Twilio - optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone
